PORT=5000
MONGODB_URI=mongodb://localhost:27017/animal_planet
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5500
# SMTP / email settings used by config/email.js
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- PetGPT AI provider config (backend/config/ai.js) ----
# Active provider: "google" (default) or "openai" (any OpenAI-compatible endpoint).
# PETGPT_PROVIDER=google
# Limits every provider (timeouts / question length, milliseconds / chars).
# PETGPT_TIMEOUT_MS=25000
# PETGPT_MAX_QUESTION_LENGTH=2000
# Google/Gemini provider.
# GEMINI_API_KEY=
# PETGPT_MODEL=gemini-1.5-flash
# OpenAI-compatible provider (e.g. OmniRoute, proxies, local servers).
# PETGPT_OPENAI_BASE_URL=http://localhost:11434
# PETGPT_OPENAI_API_KEY=
# PETGPT_OPENAI_MODEL=

# ---- PetGPT provider configuration (Phase 3, backend/ai + utils/cipher.js) ----
# Application-level encryption secret for stored provider API keys
# (AES-256-GCM; a sha256 of this value derives the 32-byte key).
# Required before any provider API key can be persisted; without it
# provider configuration creation fails safely (nothing plaintext is stored).
# PETGPT_ENCRYPTION_KEY=

# ---- PetGPT conversation/history limits (backend/config/ai.js, Phase 2) ----
# Prior user/assistant messages fed to the provider as context per exchange.
# PETGPT_MAX_HISTORY_MESSAGES=20

# ---- PetGPT local E2E (backend/test/petgpt-omniroute.test.js) ----
# Points the provider at the local OmniRoute container's OpenAI-compatible
# endpoint (or any compatible server). The test SKIPS when
# PETGPT_OPENAI_API_KEY is unset; no public API key is required.
# PETGPT_OPENAI_BASE_URL=http://localhost:20128/v1
# PETGPT_OPENAI_MODEL=auto/best-fast
