PORT=5000
MONGODB_URI=mongodb://localhost:27017/animal_planet
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5500
# SMTP / email settings used by config/email.js
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# GEMINI_API_KEY=

# ---- PetGPT provider (enhanced backend, see origin/main .env.example) ----
# Active provider: "google" (default) or "openai" (any OpenAI-compatible endpoint).
# PETGPT_PROVIDER=openai
# Point the openai adapter at the local OmniRoute container (docker network
# edutech_default — no host port is published, use the container IP). OmniRoute
# accepts any non-empty key; model "auto" routes to a real upstream model.
# PETGPT_OPENAI_BASE_URL=http://172.18.0.2:20128/v1
# PETGPT_OPENAI_API_KEY=
# PETGPT_OPENAI_MODEL=auto
