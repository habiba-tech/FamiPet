# Copy to docker-final/.env (gitignored) and fill real values.
# Nothing here is a secret; backend secrets live in the existing
# gitignored ../backend/.env and are injected at runtime via env_file.
# Never commit a .env file.

# Public origin the backend uses for emailed deep links / CORS.
# Keep in sync with the entry nginx host port above.
CLIENT_URL=http://localhost:18081
FRONTEND_URL=http://localhost:18081

# API base baked into the React bundle at build time
# ("/api" = same-origin through the nginx reverse proxy).
VITE_API_URL=/api

# Cloudflare tunnel token (only needed for the "tunnel" profile).
TUNNEL_TOKEN=