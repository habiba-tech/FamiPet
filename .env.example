# =========================================================
# FAMIPET - ROOT ENVIRONMENT CONTRACT (tracked template)
# =========================================================
# Copy to .env (gitignored) and fill real values. Nothing here is a secret.
#
# ENVIRONMENT MODEL
#
#   Normal FamiPet deployment
#           |
#         .env  (this file, gitignored)  <- the ONE place a deployment
#           |                              operator changes values
#      docker-compose.yml  (interpolates these variables explicitly and
#           |               passes only what each service needs)
#      individual services (frontend, backend, ai, nginx, mongodb, cloudflared)
#
#   Running one service alone (development, NOT deployment)
#           |
#     <service>/.env.example  -> developer creates <service>/.env -> that service
#
# Service-local .env files are development/standalone configuration only.
# They are never the source of truth for the normal deployment: Compose does
# not read them. backend/.env.example and ai/.env.example document the
# standalone path; this file is the complete contract for `docker compose up`.
#
# docker-compose.yml reads this file automatically for ${...} interpolation
# and maps each variable it needs into the right container. It does NOT dump
# the whole file into every container.
# =========================================================

# ---------------------------------------------------------------
# EDGE / FRONTEND
# ---------------------------------------------------------------

# Public host port the app is published on (nginx listens on 80 inside).
APP_PORT=8080

# API base baked into the React bundle at build time.
# "/api" = same-origin through the nginx reverse proxy. Change only for a
# split-origin deployment:
#   docker compose build --build-arg VITE_API_URL=https://api.example.com/api frontend
VITE_API_URL=/api

# Public origin(s) the backend uses for emailed deep links (verify/reset)
# + CORS. Must match the hostname users actually browse to, or the emailed
# links break.
#
# It MUST also list every origin the app is actually served from,
# comma-separated. A tunnel makes the app same-origin, but the browser still
# sends an Origin header on every POST/PUT/PATCH/DELETE (never on same-origin
# GET/HEAD). The backend checks that header against this list, so an origin
# missing here fails every write - login, settings - while reads keep working
# and the app looks healthy. Add the tunnel hostname alongside localhost:
#   CLIENT_URL=http://localhost:8080,https://your-public-host
CLIENT_URL=http://localhost:8080

# The ONE public origin generated QR codes (Digital Pet ID) point at.
# Deliberately separate from CLIENT_URL: that list starts with localhost for
# local development, and a scanned QR off localhost is useless. Set this to
# the hostname users actually scan into:
#   PUBLIC_APP_URL=https://your-public-host
# Leave empty for local development (falls back to CLIENT_URL's first entry).
PUBLIC_APP_URL=

# Cloudflare tunnel token. cloudflared starts with the normal stack
# (`docker compose up`, no profile needed). With no valid token the
# cloudflared container keeps restarting - the rest of the stack is
# unaffected - so fill this when you use the public tunnel.
# The public hostname -> http://nginx:80 mapping lives in the Cloudflare
# Zero Trust dashboard, not here.
TUNNEL_TOKEN=

# ---------------------------------------------------------------
# BACKEND - core
# ---------------------------------------------------------------

# Database URL. Inside Compose the MongoDB service resolves by service name;
# this default is correct for the normal deployment and is overridden into
# the backend container explicitly (no service-local env file is involved).
MONGODB_URI=mongodb://mongodb:27017/petDB

# JWT signing key + lifetime. REQUIRED: `docker compose config` fails fast
# with a clear error if this is missing. Generate once per deployment:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d
#
# The backend also validates its environment at startup (backend/config/env.js,
# using zod): MONGODB_URI and JWT_SECRET missing -> it refuses to start and
# lists exactly what is missing; the optional groups below (email/push/AI/
# cloudinary) that are half-configured are reported as boot warnings naming
# the missing variable(s).

# Winston log level (debug, info, warn, error).
LOG_LEVEL=info

# Runtime mode of the backend. The Compose default is "production", which
# disables the legacy frontend fallback listener and restricts CORS to the
# CLIENT_URL allow-list (no localhost / private-LAN development origins).
# Only set this to "development" for local debugging.
# NODE_ENV=production

# The API port inside the stack is fixed at 5000 (nginx, the image
# healthcheck and the compose topology all use backend:5000); PORT is
# deliberately not configurable here.

# ---------------------------------------------------------------
# BACKEND - email transport (config/email.js)
# Required for registration verification + password reset to complete.
# Unset (both EMAIL_USER and EMAIL_PASS empty) = those flows fail visibly
# with a clear 503 and the backend prints an "ENV: Email transport not
# configured" warning at boot; the rest of the app runs normally.
# ---------------------------------------------------------------
# EMAIL_SERVICE=gmail
# EMAIL_USER=
# EMAIL_PASS=

# ---------------------------------------------------------------
# BACKEND - optional: image hosting (config/cloudinary.js)
# Unset = uploads are stored locally in the backend container volume.
# ---------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------
# PETGPT - the ONE OpenAI-compatible chat-completions endpoint
# ---------------------------------------------------------------
# APPLICATION-LEVEL ONLY. There are no per-user AI providers and no
# per-user API keys anywhere in the app. All three unset = PetGPT stays
# disabled - every generation fails safely with a "provider" error, and the
# app is otherwise fully usable.
#
# Base URL is the chat-completions ROOT (the adapter appends
# /chat/completions). No trailing slash. The implementation behind it (a
# gateway, a proxy, a self-hosted server, a remote provider) is the
# deployment's business - FamiPet only needs base URL + key + model.
#
# Defaults below are FamiPet's own OmniRoute gateway, host-local on the
# deployment machine. From inside a container "localhost" is the container
# itself, so the host is reached through the host.docker.internal alias the
# stack maps to the host gateway (see docker-compose.yml). A host-local
# endpoint must therefore listen on a routable address; a remote
# OpenAI-compatible provider works as-is. A 172.x container IP is never
# used - it changes on every recreate.
#
# `dummy-key` is a PLACEHOLDER, not a secret: OmniRoute accepts any
# non-empty bearer value on /v1/chat/completions. Point this at a hosted
# provider and the real key goes here - never into a tracked file.
PETGPT_OPENAI_BASE_URL=http://host.docker.internal:20128/v1
PETGPT_OPENAI_API_KEY=dummy-key
PETGPT_OPENAI_MODEL=free-chat

# Optional tuning (defaults shown; all are mapped into the backend
# container, so editing them here changes the deployment). Full
# explanations in backend/.env.example (backend/config/ai.js):
#   request limits          PETGPT_TIMEOUT_MS=25000
#                           PETGPT_MAX_QUESTION_LENGTH=2000
#                           PETGPT_MAX_HISTORY_MESSAGES=20
#   generation worker       PETGPT_WORKER_POLL_MS=300
#                           PETGPT_WORKER_STALE_MS=60000
#                           PETGPT_MAX_JOB_ATTEMPTS=2
#   tool calling            PETGPT_MAX_TOOL_ITERATIONS=3
#                           PETGPT_TOOL_MAX_RESULTS=10
#                           PETGPT_CONTEXT_MAX_PETS=5
#   per-user quota          PETGPT_RATE_LIMIT_MAX=30
#                           PETGPT_RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------
# BREED AI (the Python service in ai/, internal on the Compose network)
# ---------------------------------------------------------------
# Backend address of the `ai` service. The Compose default points at the
# internal service, so a normal `docker compose up` needs no change here.
# Unset/empty disables the feature (the backend just reports it off).
PET_BREED_AI_URL=http://ai:8000

# Optional tuning (defaults shown; also documented in ai/.env.example for
# standalone runs of the service):
#   PET_BREED_AI_TIMEOUT_MS=20000        backend-side request timeout
#   PET_BREED_MAX_UPLOAD_BYTES=8388608   backend-side upload ceiling
#   PET_BREED_AI_TOP_K=5                 candidates returned per image
#   PET_BREED_MIN_CONFIDENCE=0.35        confident-breed threshold
#   PET_BREED_MIN_CONFIDENCE_GENERIC=0.55 generic-label threshold
#   PET_BREED_AI_ENRICH=true             enrich candidates in the backend
#   AI_MAX_UPLOAD_BYTES=8388608          service-side upload ceiling
#   AI_TOP_K=5                           service-side default top-k
#   AI_INFERENCE_TIMEOUT_S=20            service-side inference bound

# ---------------------------------------------------------------
# BACKEND - optional: browser push / VAPID (config/push.js)
# ---------------------------------------------------------------
# Push FAILS CLOSED when unset: the whole app works and push is simply off
# (the Settings toggle reports it is not configured). Generate a pair once
# per deployment and put it here (gitignored - never in a tracked file):
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-domain.example
