# Copy to .env (gitignored) and fill real values. Nothing here is a secret.
#
# This file configures the ROOT docker-compose.yml only. The backend reads its
# OWN real configuration (Mongo/JWT/SMTP/Cloudinary/every PETGPT_* var) from
# backend/.env via `env_file` - see backend/.env.example for that list.
# Fill real secrets into your LOCAL .env only and never commit it.

# Public host port the app is published on (nginx listens on 80 inside).
APP_PORT=8080

# API base baked into the React bundle at build time.
# "/api" = same-origin through the nginx reverse proxy. Change only for a
# split-origin deployment:
#   docker compose build --build-arg VITE_API_URL=https://api.example.com/api frontend
VITE_API_URL=/api

# Public origin the backend uses for emailed deep links (verify/reset) + CORS.
# Must match the hostname users actually browse to, or the emailed links break.
CLIENT_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Cloudflare tunnel token - ONLY needed for the optional "tunnel" profile:
#   docker compose --profile tunnel up -d cloudflared
# Leave empty otherwise; a plain `docker compose up` never starts cloudflared.
# The public hostname -> http://nginx:80 mapping lives in the Cloudflare Zero
# Trust dashboard, not here.
TUNNEL_TOKEN=

# ---------------------------------------------------------------
# Only used with the optional override docker-compose.omniroute.yml
# ---------------------------------------------------------------
# Name of the EXTERNAL Docker network that an already-running OmniRoute
# container is attached to. The FamiPet backend joins that network and reaches
# OmniRoute by SERVICE NAME, so a recreated container never breaks PetGPT:
#   docker compose -f docker-compose.yml -f docker-compose.omniroute.yml up -d
#   # then in backend/.env:
#   #   PETGPT_OPENAI_BASE_URL=http://omniroute:20128/v1
# Defaults to edutech_default. Change it if OmniRoute runs in another project.
OMNIROUTE_NETWORK=edutech_default
