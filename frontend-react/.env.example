# Copy to .env (gitignored) and fill real values. Nothing here is a secret;
# fill real secrets into your LOCAL .env only and never commit it.

# Strong random JWT secret for the validation stack. Generate with:
#   openssl rand -hex 64   (or: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# NEVER reuse the production secret.
JWT_SECRET=

# Optional overrides (defaults match this compose / the app):
# API base baked into the React bundle at build time ("/api" = same-origin
# through the nginx reverse proxy; change only for a split-origin deployment).
# Build with: docker compose build --build-arg VITE_API_URL=http://api.example.com/api frontend
VITE_API_URL=/api

# Public origin the backend uses for emailed deep links (verify/reset).
CLIENT_URL=http://localhost:18080
FRONTEND_URL=http://localhost:18080

# Cloudflare tunnel token (only needed for the "tunnel" profile).
TUNNEL_TOKEN=

# NODE_ENV (development matches the existing running deployment).
NODE_ENV=development